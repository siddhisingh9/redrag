# RedRAG environment variables.
# Copy this file to `.env` and fill in what you need:  cp .env.example .env
# `.env` is gitignored. Never commit real keys.
# Any variable set here overrides the matching value in config/default.yaml.
# A variable that is already set in your shell wins over this file.

# --- Which config file to load (optional) ---------------------------------
# REDRAG_CONFIG=config/default.yaml

# --- LLM provider for the victim + attacker models -------------------------
# "ollama" for real local models, "mock" for the offline scripted client (tests/CI).
REDRAG_LLM_PROVIDER=ollama

# --- Ollama (local models) ------------------------------------------------
# Where the Ollama server listens.
OLLAMA_HOST=http://localhost:11434
# Model the target chatbot uses (the "victim"). Must fit in 4 GB VRAM (~3B, quantized).
OLLAMA_VICTIM_MODEL=llama3.2:3b
# Model the attacker agent uses to rewrite attacks. Same model by default to avoid
# swapping two models in and out of 4 GB of VRAM.
OLLAMA_ATTACKER_MODEL=llama3.2:3b

# --- Embeddings -----------------------------------------------------------
# "sentence-transformers" (real bge-small model, downloaded once, runs on CPU)
# or "hashing" (offline word matching, no download; used by tests and CI).
REDRAG_EMBEDDINGS_PROVIDER=sentence-transformers

# --- Gemini API (free tier only) ------------------------------------------
# Get a free key at https://aistudio.google.com/apikey (no credit card needed).
GEMINI_API_KEY=
# A free-tier Flash / Flash-Lite model name, as listed in AI Studio.
GEMINI_MODEL=gemini-2.5-flash-lite
# Max Gemini requests RedRAG may send per day (keeps you under the free quota).
GEMINI_DAILY_BUDGET=200

# --- Judge (M4) -----------------------------------------------------------
# Folder holding the fine-tuned judge model (output of notebooks/finetune_judge.ipynb).
# REDRAG_JUDGE_MODEL_DIR=models/judge-deberta
# Your hand labels (commit this file) and the exported training dataset.
# REDRAG_LABELS_FILE=data/labels/hand_labels.jsonl
# REDRAG_DATASET_DIR=data/judge_dataset

# --- Target app + outputs -------------------------------------------------
# URL of the target RAG app the scanner attacks.
REDRAG_TARGET_URL=http://127.0.0.1:8000
# Folder where scan results and reports are written.
REDRAG_RUNS_DIR=runs
